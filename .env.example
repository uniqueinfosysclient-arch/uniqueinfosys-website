# ------------------------------------------------------------
# Client-side (bundled into the browser — safe to be public).
# Supabase CMS: news strip, About gallery, offers, download links.
# Copy to .env.local and fill in from Supabase → Settings → API.
# Leave unset to run the site without the CMS (falls back to
# built-in content).
# ------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# Server-side only — used by api/lead.js (the website lead form).
# NEVER prefix these with VITE_; that would inline them into the
# browser bundle and leak the service-role key.
#
# In production these live in Vercel → Project → Settings →
# Environment Variables. Locally, put them in .env.local and the
# dev server picks them up (see apiDevServer in vite.config.js).
# ------------------------------------------------------------

# Optional — falls back to VITE_SUPABASE_URL above when left blank.
# Only set this if the API should talk to a different Supabase project.
SUPABASE_URL=

# The two below are independent — set either, or both. With only the
# service_role key the form stores leads but sends no email; with only the
# Resend key it emails without storing. The form fails only when BOTH are
# blank, because then an enquiry would simply vanish.

# Enables storing leads (and the Website leads page in the admin panel).
# Supabase → Settings → API → Project API keys → service_role.
# Bypasses Row Level Security. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Enables the notification email.
# resend.com → API Keys. Free tier covers ~3,000 emails/month.
RESEND_API_KEY=

# Optional. Where enquiry notifications are delivered.
# Defaults to unisysjpr@yahoo.com when unset.
LEAD_TO_EMAIL=

# Optional. The "from" address on notification mails.
# Defaults to onboarding@resend.dev, which works immediately with no
# setup but is shared and Resend-branded. To send from your own domain
# (e.g. leads@uniqueinfosys.com), verify that domain in Resend first.
LEAD_FROM_EMAIL=
